# %% Task 7 - 5-fold cross-validation for model selection (Plot 13) - light 160x160
configs_for_cv = {
    "C1_baseline": dict(lr=1e-3, dropout=0.0, use_bn=False),
    "C2_best_reg": dict(lr=1e-3, dropout=0.5, use_bn=True),
    "C3_best_optimizer": dict(lr=1e-3, dropout=0.25, use_bn=True),
    "C4_best_hparams": dict(lr=1e-4, dropout=0.25, use_bn=True),
}
EPOCHS = 5
CV_TRAIN_SUBSET = 700   # smaller than Tasks 1-5's subset - CV trains 20 models total (4 configs x 5 folds)
CV_VAL_SUBSET = 150

combined_ds = ds_train.take(CV_TRAIN_SUBSET).concatenate(ds_val.take(CV_VAL_SUBSET)).map(
    make_preprocess(IMG_SIZE_SMALL), num_parallel_calls=tf.data.AUTOTUNE
)
X_all = np.stack([img.numpy() for img, _ in combined_ds])
y_all = np.array([lbl.numpy() for _, lbl in combined_ds])
del combined_ds
gc.collect()

kf = KFold(n_splits=5, shuffle=True, random_state=42)
cv_results = {name: [] for name in configs_for_cv}

for name, cfg in configs_for_cv.items():
    print(f"Cross-validating {name}")
    for fold, (train_idx, val_idx) in enumerate(kf.split(X_all), start=1):
        tf.keras.backend.clear_session()
        _, model = build_model(tf.keras.initializers.HeNormal(), IMG_SIZE_SMALL, dropout=cfg["dropout"], use_bn=cfg["use_bn"])
        model.compile(optimizer=optimizers.Adam(learning_rate=cfg["lr"]), loss="sparse_categorical_crossentropy", metrics=["accuracy"])
        model.fit(X_all[train_idx], y_all[train_idx], validation_data=(X_all[val_idx], y_all[val_idx]),
                   epochs=EPOCHS, batch_size=BATCH_SMALL, verbose=0)
        _, acc = model.evaluate(X_all[val_idx], y_all[val_idx], verbose=0)
        cv_results[name].append(acc * 100)
        print(f"  Fold {fold}: val acc = {acc * 100:.2f}%")
        free_memory(model)
    gc.collect()  # extra sweep after each config's 5 folds

print("\nConfig | F1 | F2 | F3 | F4 | F5 | Mean +/- SD")
cv_summary = {}
for name, accs in cv_results.items():
    mean, sd = np.mean(accs), np.std(accs)
    cv_summary[name] = (mean, sd)
    print(f"{name}: {accs} -> {mean:.2f} +/- {sd:.2f}")

plt.figure(figsize=(6, 4))
names = list(cv_summary.keys())
means = [cv_summary[n][0] for n in names]
sds = [cv_summary[n][1] for n in names]
plt.bar(names, means, yerr=sds, capsize=5)
plt.ylabel("Mean Validation Accuracy (%)")
plt.title("Plot 13: 5-Fold Cross-Validation Accuracy")
plt.xticks(rotation=15); plt.grid(alpha=0.3, axis="y"); plt.show(); plt.close('all')

best_config_name = max(cv_summary, key=lambda n: cv_summary[n][0])
print(f"\nBest configuration by mean CV accuracy: {best_config_name}")

# X_all/y_all (160x160) no longer needed once CV is done - Task 8 retrains at 224x224 from the tf.data pipeline instead.
free_memory(X_all, y_all)


# %% Task 8 - Final model evaluation on the held-out test set (Plot 14, Plot 15) - full 224x224
best_cfg = configs_for_cv[best_config_name]
EPOCHS = 5

# Retrain on full train+val at 224x224 using the tf.data pipeline (no large numpy array needed).
combined_ds_f = ds_train.concatenate(ds_val)
retrain_ds_f = make_pipeline(combined_ds_f, IMG_SIZE_FULL, shuffle=True, augment=True, batch_size=BATCH_FULL)

tf.keras.backend.clear_session()
_, final_model = build_model(tf.keras.initializers.HeNormal(), IMG_SIZE_FULL, dropout=best_cfg["dropout"], use_bn=best_cfg["use_bn"])
final_model.compile(optimizer=optimizers.Adam(learning_rate=best_cfg["lr"]), loss="sparse_categorical_crossentropy", metrics=["accuracy"])

t0 = time.time()
final_model.fit(retrain_ds_f, epochs=EPOCHS, verbose=1)
train_time = time.time() - t0

y_true, y_pred, mis_samples = [], [], []  # mis_samples holds only mismatched images, capped at 6
for imgs, lbls in test_ds_f:
    preds = final_model.predict(imgs, verbose=0)
    pred_labels = np.argmax(preds, axis=1)
    lbls_np = lbls.numpy()
    imgs_np = imgs.numpy()
    y_true.extend(lbls_np)
    y_pred.extend(pred_labels)
    for i in range(len(lbls_np)):
        if lbls_np[i] != pred_labels[i] and len(mis_samples) < 6:
            mis_samples.append((imgs_np[i], lbls_np[i], pred_labels[i]))
    del imgs_np  # don't keep the full batch of images around once mismatches are extracted

test_acc = np.mean(np.array(y_true) == np.array(y_pred))
precision = precision_score(y_true, y_pred, average="macro")
recall = recall_score(y_true, y_pred, average="macro")
f1 = f1_score(y_true, y_pred, average="macro")
num_params = final_model.count_params()

print(f"Mean CV Accuracy: {cv_summary[best_config_name][0]:.2f}")
print(f"CV Standard Deviation: {cv_summary[best_config_name][1]:.2f}")
print(f"Test Accuracy: {test_acc * 100:.2f}%")
print(f"Precision: {precision:.3f} | Recall: {recall:.3f} | F1-score: {f1:.3f}")
print(f"Training Time: {train_time:.1f}s | Parameters: {num_params:,}")

cm = confusion_matrix(y_true, y_pred)
plt.figure(figsize=(4.5, 4))
plt.imshow(cm, cmap="Blues")
plt.title("Plot 14: Confusion Matrix")
plt.xlabel("Predicted"); plt.ylabel("Actual")
plt.xticks([0, 1], ["Cat", "Dog"]); plt.yticks([0, 1], ["Cat", "Dog"])
for i in range(cm.shape[0]):
    for j in range(cm.shape[1]):
        plt.text(j, i, cm[i, j], ha="center", va="center")
plt.colorbar(); plt.show(); plt.close('all')

if mis_samples:
    plt.figure(figsize=(12, 4))
    for k, (img, true_lbl, pred_lbl) in enumerate(mis_samples):
        plt.subplot(1, len(mis_samples), k + 1)
        img_display = np.clip((img + 1) / 2, 0, 1)  # undo MobileNetV2 preprocessing for display
        plt.imshow(img_display)
        plt.title(f"True:{true_lbl} Pred:{pred_lbl}", fontsize=8)
        plt.axis("off")
    plt.suptitle("Plot 15: Misclassified Images")
    plt.show(); plt.close('all')

free_memory(final_model)
